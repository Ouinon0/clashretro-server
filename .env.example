# Copier en .env et remplir. Générer chaque secret avec : openssl rand -hex 32
MYSQL_DATABASE=clashretro
MYSQL_USER=clashretro
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
CLUSTER_KEY=
PAIRING_SECRET=
PORTAL_SECRET=

# Dossier persistant (TrueNAS : /mnt/<pool>/apps/clashretro/data)
DATA_DIR=./data
GAME_PORT=9339
PORTAL_PORT=8080
# true si le portail est servi en HTTPS (reverse proxy)
PORTAL_SECURE_COOKIE=false

# Accès : false = n'importe quel client crée un compte (tests uniquement)
REQUIRE_INVITE=true
INVITE_VALID_DAYS=14

# Progression
START_GOLD=5000
START_GEMS=1000000
CARD_MULTIPLIER=3
GOLD_MULTIPLIER=5
MIN_CHEST_GOLD=100
# Durée de déverrouillage des coffres (% du jeu d'origine : 25 = argent en 45 min au lieu de 3 h)
UNLOCK_TIME_PERCENT=25
# Commandes de test dans le chat de clan (/max, /gold…) : à laisser à false entre amis
CHAT_CHEATS=false
# Prix du magasin en % du jeu d'origine (cartes en or, coffres en gemmes) : 50 = moitié prix
SHOP_PRICE_PERCENT=50

# Journal de combat anonyme (équilibrage) : identifiants hachés, ni pseudo ni IP
BATTLE_LOGS=true
BATTLE_LOG_RETENTION_DAYS=90
BATTLE_LOG_SALT=

# Profil dns uniquement
SERVER_IP=192.168.1.50
UPSTREAM_DNS=1.1.1.1
